<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Light only: stops mail apps from auto-inverting the brand colours. -->
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Xác minh email của bạn</title>
  </head>
  <!-- Email-safe markup: tables and inline styles only. Colours follow the app (packages/app/src/global.css). -->
  <body style="margin:0;padding:0;background-color:#f7f7f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0e0e10;-webkit-font-smoothing:antialiased;">
    <!-- Inbox preview line, hidden in the message itself. -->
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      Mã xác minh Athena của bạn là {{code}}, có hiệu lực trong {{expiresInMinutes}} phút.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f7f5" style="background-color:#f7f7f5;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;">
            <!-- Header: coral to orange; solid coral where gradients aren't supported (Outlook). -->
            <tr>
              <td align="center" bgcolor="#ff4d3d" style="background-color:#ff4d3d;background-image:linear-gradient(135deg,#ff4d3d 0%,#ff7a3d 55%,#ffa13d 100%);border-radius:20px 20px 0 0;padding:36px 32px 32px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td align="center" valign="middle" width="72" height="72" bgcolor="#ffffff" style="width:72px;height:72px;background-color:#ffffff;border-radius:36px;text-align:center;box-shadow:0 6px 16px rgba(14,14,16,0.18);">
                      <img src="cid:athena-logo" width="44" height="44" alt="Athena" style="display:block;margin:0 auto;width:44px;height:44px;border:0;outline:none;text-decoration:none;" />
                    </td>
                  </tr>
                </table>
                <p style="margin:16px 0 0;font-size:26px;font-weight:800;letter-spacing:0.5px;color:#ffffff;">Athena</p>
                <p style="margin:4px 0 0;font-size:14px;color:#fff3ef;">Người bạn đồng hành học tập của bạn</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td bgcolor="#ffffff" style="background-color:#ffffff;padding:36px 32px 8px;">
                <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;font-weight:700;color:#0e0e10;">Xác minh email của bạn ✉️</h1>
                <p style="margin:0 0 8px;font-size:16px;line-height:1.6;color:#0e0e10;">Xin chào {{fullName}},</p>
                <p style="margin:0;font-size:16px;line-height:1.6;color:#5e5e66;">
                  Chào mừng bạn đến với Athena! Nhập mã dưới đây vào ứng dụng để hoàn tất việc tạo tài khoản:
                </p>
              </td>
            </tr>

            <!-- Code -->
            <tr>
              <td align="center" bgcolor="#ffffff" style="background-color:#ffffff;padding:24px 32px 8px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                  <tr>
                    <td align="center" bgcolor="#fff1ef" style="background-color:#fff1ef;border:2px dashed #ff4d3d;border-radius:16px;padding:22px 12px;">
                      <p style="margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#c8321f;">Mã xác minh</p>
                      <p style="margin:0;font-family:'SFMono-Regular',Menlo,Consolas,'Courier New',monospace;font-size:40px;line-height:1.2;font-weight:800;letter-spacing:10px;color:#0e0e10;">{{code}}</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Expiry badge -->
            <tr>
              <td align="center" bgcolor="#ffffff" style="background-color:#ffffff;padding:16px 32px 28px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td bgcolor="#0e0e10" style="background-color:#0e0e10;border-radius:999px;padding:8px 16px;font-size:13px;font-weight:600;color:#ffffff;">
                      ⏱ Có hiệu lực trong {{expiresInMinutes}} phút
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Security tip -->
            <tr>
              <td bgcolor="#ffffff" style="background-color:#ffffff;padding:0 32px 32px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                  <tr>
                    <td bgcolor="#fff8e6" style="background-color:#fff8e6;border-left:4px solid #ffa13d;border-radius:10px;padding:14px 16px;font-size:14px;line-height:1.55;color:#5e5e66;">
                      <strong style="color:#0e0e10;">🔒 Giữ an toàn cho tài khoản:</strong>
                      Athena sẽ không bao giờ hỏi mã này. Tuyệt đối không chia sẻ mã với bất kỳ ai.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td bgcolor="#f0f0ed" style="background-color:#f0f0ed;border-radius:0 0 20px 20px;border-top:1px solid #e2e2de;padding:20px 32px;font-size:13px;line-height:1.55;color:#5e5e66;text-align:center;">
                Nếu bạn không đăng ký tài khoản Athena, hãy bỏ qua email này.<br />
                <span style="color:#b8b8be;">© Athena · Học mỗi ngày, tiến bộ mỗi ngày</span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
