# HS256 secret, at least 32 bytes: openssl rand -base64 48
JWT_SECRET=

PORT=8080

NODE_ENV=development
# Mailpit locally; the provider's SMTP server in production (SMTP_SECURE=true for port 465).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Athena <no-reply@athena.local>"

# RabbitMQ (local dev)
RABBITMQ_USER=athena
RABBITMQ_PASSWORD=athena
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
